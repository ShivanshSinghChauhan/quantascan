{
  "name": "quantascan",
  "version": "1.0.0",
  "description": "High-performance Post-Quantum Cryptography (PQC) static analysis CLI and automated CycloneDX v1.6 CBOM engine",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "pqc-scan": "./dist/bin/pqc-scan.js"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "serve": "node ./dist/bin/pqc-scan.js --serve"
  },
  "keywords": [
    "pqc",
    "post-quantum",
    "cryptography",
    "cbom",
    "cyclonedx",
    "nist-fips-203",
    "nist-fips-204",
    "nist-fips-205",
    "cnsa-2.0",
    "security",
    "ast",
    "tree-sitter"
  ],
  "author": "QuantaScan Core Team",
  "license": "Apache-2.0",
  "dependencies": {
    "commander": "^13.1.0",
    "fast-glob": "^3.3.3",
    "picocolors": "^1.1.1",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.22.6"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "typescript": "^5.7.3"
  }
}
